# star_stock_align.config - align our kernel config to the stock HyperOS 2.0.7.0
# kernel (5.4.274-g4dfe63e0666f, extracted via IKCONFIG from the official OTA
# boot.img). Only contains symbols that exist in this tree; Xiaomi-private
# configs absent from the public sources are documented in
# docs/stock-config-delta.md and must NOT be set here.
#
# Merge order:
#   lahaina-qgki_defconfig -> star_QGKI.config -> star_root.config -> olddefconfig
#   -> this fragment -> olddefconfig

# kernel cmdline default: stock reserves 4 MB ramoops via cmdline
CONFIG_CMDLINE="ramoops_memreserve=4M"

# logging: stock keeps a 2 MB log buffer
CONFIG_LOG_BUF_SHIFT=21

# ipc log minidump: stock disables the fixed 16-buffer dump
CONFIG_IPC_LOG_MINIDUMP_BUFFERS=0

# module parity: stock builds these as modules; built-in versions break the
# 1:1 device tree / sysfs expectations with stock userspace
# CONFIG_CNSS2=m (kept y: icnss2/cacld tracepoint+symbol wiring; bake later)

# CONFIG_CNSS_QMI_SVC=m

# CONFIG_ICNSS2=m (kept y: needs in-kernel pil_restart_level tracepoint)

CONFIG_LEDS_CLASS_FLASH=m
CONFIG_LEDS_QTI_FLASH=m
CONFIG_LEDS_QTI_TRI_LED=m
CONFIG_LEDS_TRIGGER_TIMER=m
# CONFIG_QTI_BATTERY_CHARGER=m  # built-in qcom-spmi-wled consumes qti_battery_charger_get_prop (kept from tree default y)
CONFIG_MI_HARDWARE_ID=y
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_NFC_QTI_I2C=m

# stock-only features that exist in this public tree
CONFIG_I3C=y
CONFIG_I3C_MASTER_MSM_GENI=y
CONFIG_MTD=y
CONFIG_MTD_BLKDEVS=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_BLOCK2MTD=y
CONFIG_MTD_OOPS=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_CFI_I1=y
CONFIG_MTD_CFI_I2=y
CONFIG_MTD_MAP_BANK_WIDTH_1=y
CONFIG_MTD_MAP_BANK_WIDTH_2=y
CONFIG_MTD_MAP_BANK_WIDTH_4=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_SERIAL_MSM_GENI_EARLY_CONSOLE=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y
CONFIG_CFG80211_CRDA_SUPPORT=y

# static usermode helper path (stock /system/bin/micd)
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH="/system/bin/micd"

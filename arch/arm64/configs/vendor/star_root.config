# Mi 11 Ultra (star) Android 14 / Linux 5.4.274 root build
# ReSukiSU is built into the kernel with SUSFS inline-hook integration.
# Match the stock HyperOS 2.0.7.0 release string exactly so vendor_dlkm
# module vermagic stays compatible (stock: 5.4.274-qgki-g4dfe63e0666f).
CONFIG_LOCALVERSION="-qgki-g4dfe63e0666f"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KSU=y
# SUSFS hook mode (replaces the previous KSU_MANUAL_HOOK choice)
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
# CONFIG_KSU_SUSFS_SUS_SU is not supported by ReSukiSU's Kconfig menu;
# the susfs sus_su daemon-less su stays disabled and the manual
# execveat/faccessat/stat hooks above (guarded by CONFIG_KSU) stay active.
